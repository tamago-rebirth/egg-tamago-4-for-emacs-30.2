ーーー
デバッグ version
(defun egg-string-as-multibyte (str &optional coding)
  "DEBUG: Safer wrapper of string-as-multibyte for EGG tests."
  (let ((result
         (condition-case err
             (progn
               (when (not (stringp str))
                 (error "Non-string input: %S" str))
               (let ((res (string-as-multibyte str)))
                 (message "[egg-debug] input=%S result=%S (len=%d)"
                          str res (length res))
                 res))
           (error
            (message "[egg-debug] ERROR in string-as-multibyte: %s" err)
            nil))))
    result))




今までの定義
egg-string-as-multibytes
#[(str &optional coding)
  ((let*
       ((coding (egg--choose-coding coding))
        (new
         (if (fboundp 'decode-coding-string)
             (decode-coding-string str coding)
           (string-as-multibyte str)))
        (old
         (and (fboundp 'string-as-multibyte)
              (condition-case nil (progn (string-as-multibyte str))
                (error nil)))))
     (egg--verify-string-conversion old new "egg-string-as-multibyte"
                                    coding)))
  nil nil
  "Backwards-compatible replacement for `string-as-multibyte'.\nIf CODING is non-nil it specifies the coding to use for decode-coding-string.\nIf `decode-coding-string' is available use it; else fall back to\n`string-as-multibyte'.  On mismatch consult `egg-string-as-debug-flag'."]

